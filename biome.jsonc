{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core", "ultracite/biome/react"],
  "overrides": [
    {
      "includes": ["apps/**"],
      "linter": {
        "rules": {
          "performance": { "noJsxPropsBind": "off" },
          "suspicious": { "noLeakedRender": "off" }
        }
      }
    }
  ],
  "files": {
    "includes": [
      "!!contracts/lib",
      "!!contracts/out",
      "!!docs",
      "!!.claude",
      "!!**/dist",
      "!!**/dev-dist"
    ]
  }
}
