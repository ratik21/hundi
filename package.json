{
  "name": "hundi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "bun run --filter '@hundi/pwa' build && bun run --filter '@hundi/shop' build",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "lab": "scripts/lab/up.sh",
    "lab:drive": "browser-harness < scripts/lab/drive.py",
    "lab:readme": "browser-harness < scripts/lab/readme-shots.py",
    "lab:shop": "browser-harness < scripts/lab/drive-shop.py",
    "lab:sim": "python3 scripts/lab/sim-drive.py",
    "relayer": "scripts/relayer-deploy.sh",
    "test": "bun test packages apps",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@hundi/core": "workspace:*",
    "@hundi/wallet": "workspace:*",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@types/bun": "1.4.4",
    "@types/node": "24.19.2",
    "lefthook": "latest",
    "typescript": "7.0.2",
    "ultracite": "8.1.1",
    "viem": "2.57.16"
  },
  "packageManager": "bun@1.4.4",
  "trustedDependencies": [
    "lefthook"
  ]
}
