{
  "headers": [
    {
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ],
      "source": "/(sw.js|registerSW.js|index.html|manifest.webmanifest)"
    },
    {
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ],
      "source": "/assets/(.*)"
    }
  ]
}
